{
  "installCommand": "npm install --prefix web && npm install --prefix server",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}


